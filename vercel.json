{
    "version": 2,
    "name": "attendx-frontend",
    "builds": [
        {
            "src": "**/*.php",
            "use": "@vercel/php"
        },
        {
            "src": "assets/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/assets/$1"
        },
        {
            "src": "/(.*\\.php)",
            "dest": "/$1"
        },
        {
            "src": "/",
            "dest": "/dashboard.php"
        }
    ],
    "env": {
        "API_URL": "https://attendx-t6ow.onrender.com/api"
    }
}